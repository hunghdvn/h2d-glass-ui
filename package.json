{
  "name": "h2d-glass-ui",
  "version": "0.3.1",
  "description": "Glassmorphism UI components for React 18.3+ and 19: 40 accessible components with light and dark themes, plain CSS with no runtime, ready for React Server Components.",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui",
    "ui-kit",
    "glassmorphism",
    "frosted-glass",
    "design-system",
    "dark-mode",
    "accessibility",
    "a11y",
    "react-server-components",
    "typescript",
    "css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunghdvn/h2d-glass-ui.git"
  },
  "homepage": "https://hunghdvn.github.io/h2d-glass-ui/",
  "bugs": {
    "url": "https://github.com/hunghdvn/h2d-glass-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.34.6",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "Safari >= 17.4",
    "iOS >= 17.4"
  ],
  "scripts": {
    "gen:theme": "tsx scripts/build-theme.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit --project unit-react18 --project scripts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:docs-tables": "tsx scripts/check-docs-tables.ts",
    "check:name": "tsx scripts/check-name.ts",
    "build": "pnpm gen:theme && tsdown && tsx scripts/build-css.ts && tsx scripts/post-build-use-client.ts",
    "check:dist-css": "tsx scripts/check-dist-css.ts",
    "check:use-client": "tsx scripts/check-use-client.ts",
    "check:rsc": "node --conditions=react-server scripts/rsc-probe.mjs",
    "check:publint": "publint --strict",
    "check:types": "attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit",
    "size:record": "tsx scripts/record-size-limits.ts",
    "check:package": "pnpm check:dist-css && pnpm check:use-client && pnpm check:rsc && pnpm check:publint && pnpm check:types && pnpm size",
    "storybook": "pnpm gen:theme && storybook dev -p 6006",
    "build-storybook": "pnpm gen:theme && storybook build",
    "test:stories": "pnpm gen:theme && vitest run --project storybook-light --project storybook-dark",
    "test:visual": "sh scripts/visual.sh",
    "test:visual:update": "sh scripts/visual.sh --update-snapshots",
    "test:visual:ci": "playwright test -c playwright.visual.config.ts",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build && pnpm check:package"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "14.1.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "browserslist": "4.29.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "lightningcss": "1.33.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-18": "npm:react@18.3.1",
    "react-dom": "19.3.0",
    "react-dom-18": "npm:react-dom@18.3.1",
    "remark-gfm": "4.0.1",
    "size-limit": "14.1.0",
    "storybook": "10.6.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
